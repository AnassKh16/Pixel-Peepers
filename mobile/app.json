{
  "expo": {
    "name": "Skorly",
    "slug": "skorly",
    "scheme": "nascon",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.skorly.mobile"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 29
          }
        }
      ]
    ]
  }
}
